#: selfdrive/selfdrived/alerts_offroad.json:Offroad_ChestnutOverheated
#, python-brace-format, drawn
msgid "Chestnut overheated. Ensure good airflow. Current GPU temperature is {}."
msgstr "Surchauffe du Chestnut. Assurez une bonne ventilation. Température actuelle du GPU : {}."

#: selfdrive/selfdrived/alerts_offroad.json:Offroad_ChestnutUncompiled
msgid "The active Chestnut model is not installed. Download it in Model Manager."
msgstr "Le modèle Chestnut actif n'est pas installé. Téléchargez-le dans le gestionnaire de modèles."

